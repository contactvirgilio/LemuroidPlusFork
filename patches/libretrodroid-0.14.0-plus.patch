+// Lemuroid Plus: the picture's real size on screen (Pixel-perfect and Integer can leave it smaller
+// than the screen, with different whole multiples across and down).
+std::pair<float, float> Video::getScreenDensityXY() {
+    auto& bounds = videoLayout.getRelativeForegroundBounds();
+    float width = std::abs(bounds[2] - bounds[0]) * videoLayout.getScreenWidth();
+    float height = std::abs(bounds[3] - bounds[1]) * videoLayout.getScreenHeight();
+    float textureWidth = std::max(getTextureWidth(), 1.0F);
+    float textureHeight = std::max(getTextureHeight(), 1.0F);
+    return { std::max(width / textureWidth, 1.0F), std::max(height / textureHeight, 1.0F) };
+}
+
+// Lemuroid Plus: reads the game's texture before any filter, for save pictures. Runs on the GL thread.
+bool Video::captureRawFrame(std::vector<int32_t>& argb, int& width, int& height) {
+    if (!renderer) return false;
+    width = renderer->lastFrameSize.first;
+    height = renderer->lastFrameSize.second;
+    if (width <= 0 || height <= 0) return false;
+
+    GLint previous = 0;
+    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &previous);
+    GLuint fbo = 0;
+    glGenFramebuffers(1, &fbo);
+    glBindFramebuffer(GL_FRAMEBUFFER, fbo);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, (GLuint) renderer->getTexture(), 0);
+    bool ok = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    std::vector<uint8_t> rgba;
+    if (ok) {
+        rgba.resize((size_t) width * height * 4);
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+        ok = glGetError() == GL_NO_ERROR;
+    }
+    glBindFramebuffer(GL_FRAMEBUFFER, previous);
+    glDeleteFramebuffers(1, &fbo);
+    if (!ok) return false;
+
+    bool swap = renderer->swapRedBlueOnRead;
+    argb.resize((size_t) width * height);
+    for (int y = 0; y < height; y++) {
+        // Hardware-rendered games draw upside down (bottom-left origin).
+        int sourceRow = rawBottomLeftOrigin ? height - 1 - y : y;
+        const uint8_t* in = rgba.data() + (size_t) sourceRow * width * 4;
+        int32_t* out = argb.data() + (size_t) y * width;
+        for (int x = 0; x < width; x++) {
+            uint32_t r = in[x * 4], g = in[x * 4 + 1], b = in[x * 4 + 2];
+            if (swap) std::swap(r, b);
+            out[x] = (int32_t) (0xFF000000u | (r << 16) | (g << 8) | b);
+        }
+    }
+    return true;
+}
+
+int Video::getQuarterTurns() {
+    int turns = (int) std::lround(videoLayout.getRotation() / (M_PI / 2.0));
+    return ((turns % 4) + 4) % 4;
+}
