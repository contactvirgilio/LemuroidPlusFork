+// Lemuroid Plus: CRT-style scanlines. Each game row is drawn as a soft beam of light: brightest
+// in the middle of the row, fading towards its edges, and wider for bright pixels (like a CRT).
+// SCAN_STRENGTH sets how dark the gaps between rows get. Every screen pixel averages the beam over
+// its own height (3 samples), so fractional scales (e.g. 3.5x) stay smooth instead of stepping.
+// Pixels stay sharp across. Below about 2 screen rows per game row the lines fade out.
+// USE_MASK adds a soft aperture grille (every third screen column favours red, green or blue).
+const std::unordered_map<std::string, std::string> ShaderManager::scanlinesParams = {
+    { "SCAN_STRENGTH", "0.5" },
+    { "SCAN_BOOST", "0.1" },
+    { "BEAM_MIN", "0.14" },
+    { "BEAM_MAX", "0.28" },
+    { "USE_MASK", "0" },
+    { "MASK_STRENGTH", "0.2" },
+};
+
+const std::string ShaderManager::scanlinesFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "uniform mediump float screenDensity;\n"
+    "\n"
+    "varying HIGHP vec2 coords;\n"
+    "varying HIGHP vec2 screenCoords;\n"
+    "\n"
+    "HIGHP float sharpX;\n"
+    "\n"
+    "lowp vec3 beam(HIGHP float y) {\n"
+    "  HIGHP float row = floor(y);\n"
+    "  mediump float d = y - row - 0.5;\n"
+    "  lowp vec3 c = texture2D(texture, vec2(sharpX, (row + 0.5) / textureSize.y)).rgb;\n"
+    "  mediump float luma = dot(c, vec3(0.299, 0.587, 0.114));\n"
+    "  mediump float w = mix(BEAM_MIN, BEAM_MAX, luma);\n"
+    "  mediump float profile = exp(-(d * d) / (2.0 * w * w));\n"
+    "  return c * profile;\n"
+    "}\n"
+    "\n"
+    "void main() {\n"
+    "  mediump float px = 1.0 / screenDensity;\n"
+    "  mediump float fx = fract(screenCoords.x);\n"
+    "  mediump float sx = 0.5 * (smoothstep(0.0, px, fx) + smoothstep(1.0 - px, 1.0, fx));\n"
+    "  sharpX = (floor(screenCoords.x) + sx) / textureSize.x;\n"
+    "\n"
+    "  HIGHP float y = screenCoords.y;\n"
+    "  lowp vec3 beams = (beam(y - px / 3.0) + beam(y) + beam(y + px / 3.0)) / 3.0;\n"
+    "  lowp vec3 plain = texture2D(texture, vec2(sharpX, (floor(y) + 0.5) / textureSize.y)).rgb;\n"
+    "\n"
+    "  mediump float strength = SCAN_STRENGTH * smoothstep(1.5, 2.5, screenDensity);\n"
+    "  lowp vec3 color = mix(plain, beams, strength) * (1.0 + SCAN_BOOST * smoothstep(1.5, 2.5, screenDensity));\n"
+    "\n"
+    "#if USE_MASK\n"
+    "  mediump float column = mod(floor(gl_FragCoord.x), 3.0);\n"
+    "  lowp vec3 mask = vec3(1.0 - MASK_STRENGTH);\n"
+    "  if (column < 0.5) mask.r = 1.0;\n"
+    "  else if (column < 1.5) mask.g = 1.0;\n"
+    "  else mask.b = 1.0;\n"
+    "  color = color * mask * (1.0 + 0.5 * MASK_STRENGTH);\n"
+    "#endif\n"
+    "\n"
+    "  gl_FragColor = vec4(min(color, vec3(1.0)), 1.0);\n"
+    "}\n";
+
+// Lemuroid Plus: handheld LCD (Game Boy, Game Boy Color, GBA) and Sunlit.
+// GRID: every pixel gap is exactly one screen pixel wide (a screen pixel is a gap when a cell edge
+// falls inside it), so the grid looks the same at whole and uneven scales; it fades out below ~3x.
+// GAP_LIGHT: Game Boy style light-grey gaps (else darker gaps for colour screens). SOFT_X: Game Boy
+// Color style blend with the side neighbour near the cell's left and right edges. PIX_SHADOW: faint
+// Game Boy pixel shadow down-right. SUBPIX: faint RGB stripes inside each cell (GBA).
+// SUNLIT: the screen is lit from the front like an unlit Game Boy Color in sunlight: dark and
+// colourful pixels cast a soft shadow down-right onto a paper-coloured back layer, light pixels
+// look see-through. Own implementation, inspired by the Pixel Transparency and Harlequin shaders.
+const std::unordered_map<std::string, std::string> ShaderManager::handheldParams = {
+    { "GRID", "1" },
+    { "GAP_LIGHT", "0" },
+    { "SOFT_X_ON", "0" },
+    { "SOFT_X", "0.18" },
+    { "PIX_SHADOW_ON", "0" },
+    { "PIX_SHADOW", "0.22" },
+    { "SUBPIX_ON", "0" },
+    { "SUBPIX", "0.07" },
+    { "BOOST", "1.0" },
+    { "SUNLIT", "0" },
+    { "SUN_STRENGTH", "0.55" },
+    { "SUN_OFFSET", "0.38" },
+    { "SUN_BLUR", "0.35" },
+    { "SUN_BRIGHT", "0" },
+    { "TRANSP", "0" },
+    { "RAINBOW", "0" },
+    { "SCAN_ON", "0" },
+    { "SCAN", "0.35" },
+    { "SCAN_BOOST", "0.06" },
+};
+
+const std::string ShaderManager::handheldFragment =
+    "#ifdef GL_OES_standard_derivatives\n"
+    "#extension GL_OES_standard_derivatives : enable\n"
+    "#endif\n"
+    "\n"
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "uniform mediump float screenDensity;\n"
+    "uniform mediump vec2 screenDensityXY;\n"
+    "\n"
+    "varying HIGHP vec2 coords;\n"
+    "varying HIGHP vec2 screenCoords;\n"
+    "\n"
+    "lowp vec3 cell(HIGHP vec2 c) {\n"
+    "  return texture2D(texture, (floor(c) + 0.5) / textureSize).rgb;\n"
+    "}\n"
+    "\n"
+    "mediump float luma(lowp vec3 c) {\n"
+    "  return dot(c, vec3(0.299, 0.587, 0.114));\n"
+    "}\n"
+    "\n"
+    "#if SUNLIT || TRANSP\n"
+    "mediump float blocks(lowp vec3 c) {\n"
+    "  return clamp((1.0 - luma(c)) * 0.85 + (max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b))) * 0.35, 0.0, 1.0);\n"
+    "}\n"
+    "\n"
+    "mediump float spread(HIGHP float q, HIGHP float i) {\n"
+    "  return smoothstep(i - SUN_BLUR, i + SUN_BLUR, q) - smoothstep(i + 1.0 - SUN_BLUR, i + 1.0 + SUN_BLUR, q);\n"
+    "}\n"
+    "#endif\n"
+    "\n"
+    "void main() {\n"
+    "  HIGHP vec2 sc = screenCoords;\n"
+    "  // Size of one screen pixel in game pixels, per axis. Measured by the GPU when it can (exact for\n"
+    "  // every scaling mode); otherwise from the picture size worked out by the app.\n"
+    "#ifdef GL_OES_standard_derivatives\n"
+    "  mediump vec2 px = max(vec2(abs(dFdx(sc.x)), abs(dFdy(sc.y))), vec2(0.0001));\n"
+    "#else\n"
+    "  mediump vec2 px = 1.0 / max(screenDensityXY, vec2(1.0));\n"
+    "#endif\n"
+    "  mediump vec2 density = 1.0 / px;\n"
+    "  mediump float fade = smoothstep(2.5, 3.5, min(density.x, density.y));\n"
+    "  lowp vec3 t = cell(sc);\n"
+    "  lowp vec3 color = t;\n"
+    "\n"
+    "#if GRID\n"
+    "  HIGHP vec2 f = fract(sc);\n"
+    "#if SOFT_X_ON\n"
+    "  lowp vec3 side = f.x < 0.5 ? cell(sc - vec2(1.0, 0.0)) : cell(sc + vec2(1.0, 0.0));\n"
+    "  mediump float e = clamp((abs(f.x - 0.5) - 0.5 + SOFT_X) / SOFT_X, 0.0, 1.0) * 0.5;\n"
+    "  t = mix(t, side, e * fade);\n"
+    "#endif\n"
+    "  // The last screen pixel of each game pixel is the gap: the next screen pixel over (or down) lands\n"
+    "  // in another game pixel. Exactly one line per edge at any scale.\n"
+    "  HIGHP vec2 a = floor(sc + 0.01 * px);\n"
+    "  HIGHP vec2 b = floor(sc + 1.01 * px);\n"
+    "  bool gap = a.x != b.x || a.y != b.y;\n"
+    "  lowp vec3 c = t;\n"
+    "  if (gap) {\n"
+    "#if GAP_LIGHT\n"
+    "    c = mix(t, vec3(0.80, 0.81, 0.78), 0.28);\n"
+    "#else\n"
+    "    c = t * 0.80;\n"
+    "#endif\n"
+    "  }\n"
+    "#if PIX_SHADOW_ON\n"
+    "  mediump float d = clamp(luma(t) - luma(cell(sc - vec2(0.25))), 0.0, 1.0);\n"
+    "  c *= 1.0 - PIX_SHADOW * 1.6 * d;\n"
+    "#endif\n"
+    "#if SUBPIX_ON\n"
+    "  mediump float column = floor(f.x * 3.0);\n"
+    "  lowp vec3 m = vec3(1.0 - SUBPIX);\n"
+    "  if (column < 0.5) m.r = 1.0;\n"
