+// Lemuroid Plus: MiSTer-style scanlines. Sharp pixels, then the lower half of every game row is
+// darkened by SCAN_STRENGTH (edges anti-aliased over one screen pixel, so they are crisp and even
+// with integer scaling). Lit rows get a small SCAN_BOOST to keep the brightness. Below about 2.5
+// screen rows per game row the lines fade out (they would flicker). USE_MASK adds an aperture
+// grille: every third screen column keeps one of red, green or blue at full strength.
+const std::unordered_map<std::string, std::string> ShaderManager::scanlinesParams = {
+    { "SCAN_STRENGTH", "0.5" },
+    { "SCAN_BOOST", "0.2" },
+    { "USE_MASK", "0" },
+    { "MASK_STRENGTH", "0.25" },
+};
+
+const std::string ShaderManager::scanlinesFragment =
+    "#ifdef GL_FRAGMENT_PRECISION_HIGH\n"
+    "#define HIGHP highp\n"
+    "#else\n"
+    "#define HIGHP mediump\n"
+    "#endif\n"
+    "\n"
+    "precision mediump float;\n"
+    "uniform lowp sampler2D texture;\n"
+    "uniform HIGHP vec2 textureSize;\n"
+    "uniform mediump float screenDensity;\n"
+    "\n"
+    "varying HIGHP vec2 coords;\n"
+    "varying HIGHP vec2 screenCoords;\n"
+    "\n"
+    "void main() {\n"
+    "  mediump float w = 1.0 / screenDensity;\n"
+    "  mediump vec2 x = fract(screenCoords);\n"
+    "  mediump vec2 sx = 0.5 * (smoothstep(vec2(0.0), vec2(w), x) + smoothstep(vec2(1.0 - w), vec2(1.0), x));\n"
+    "  mediump vec2 sharpCoords = (floor(screenCoords) + sx) / textureSize;\n"
+    "  lowp vec3 rgb = texture2D(texture, sharpCoords).rgb;\n"
+    "\n"
+    "  mediump float fade = smoothstep(1.75, 2.75, screenDensity);\n"
+    "  mediump float dark = smoothstep(0.5 - 0.5 * w, 0.5 + 0.5 * w, x.y);\n"
+    "  lowp vec3 lit = min(rgb * (1.0 + SCAN_BOOST * fade), vec3(1.0));\n"
+    "  lowp vec3 dim = rgb * (1.0 - SCAN_STRENGTH * fade);\n"
+    "  lowp vec3 color = mix(lit, dim, dark);\n"
+    "\n"
+    "#if USE_MASK\n"
+    "  mediump float column = mod(floor(gl_FragCoord.x), 3.0);\n"
+    "  lowp vec3 mask = vec3(1.0 - MASK_STRENGTH);\n"
+    "  if (column < 0.5) mask.r = 1.0;\n"
+    "  else if (column < 1.5) mask.g = 1.0;\n"
+    "  else mask.b = 1.0;\n"
+    "  color = min(color * mask * (1.0 + 0.5 * MASK_STRENGTH), vec3(1.0));\n"
+    "#endif\n"
+    "\n"
+    "  gl_FragColor = vec4(color, 1.0);\n"
+    "}\n";
